# Configuration names only. Keep actual values in hosting runtime secrets.
# This file is documentation; Workers require runtime bindings, not a browser bundle.
# D1 binding: DB (configured by hosting; not a string environment variable).

# Existing business workspace mapping (set together; not needed for isolated new users).
NEXORA_OWNER_EMAIL=
NEXORA_OWNER_WORKSPACE_ID=

# Official LinkedIn posting OAuth (see LINKEDIN_SETUP.md).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Base64-encoded 32-byte encryption key; generate privately, never commit.
LINKEDIN_TOKEN_ENCRYPTION_KEY=
# Set to a currently supported six-digit YYYYMM API version.
LINKEDIN_API_VERSION=

# Optional direct server AI. Separate from ChatGPT sign-in/subscription and n8n Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=

# n8n Credentials (not application environment variables):
# Nexora Header Auth: Authorization = Bearer <runner token>
# Gemini Header Auth: x-goog-api-key = <Google AI key>
# Optional Unipile DSN/key: configure through the private Nexora provider setup.
# Google/Facebook/GitHub OAuth and phone OTP login are not implemented by this template.
